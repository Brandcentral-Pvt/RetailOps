# ─── Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in values
# Never commit .env to version control

# ── Frontend ────────────────────────────────────────────────────────────
VITE_API_URL=https://data.brandcentral.in/api
VITE_SOCKET_URL=https://data.brandcentral.in
# Maintenance mode — set to true to show ONLY the Under Maintenance screen
VITE_MAINTENANCE_MODE=false
# Headline — wrap one word in |pipes| to render it in brand-gold serif-italic
# VITE_MAINTENANCE_TITLE=We're |restocking| the shelves.
# VITE_MAINTENANCE_MESSAGE=Your custom copy here
# ETA accepts any length (ASAP, ~2–3 hours, etc.) — wraps cleanly
# VITE_MAINTENANCE_ETA=ASAP
# VITE_MAINTENANCE_EMAIL=developer@brandcentral.in
# Optional custom logo; falls back to the RetailOps wordmark on error
# VITE_MAINTENANCE_LOGO=https://brandcentral.in/wp-content/uploads/2024/09/logo.png

# ── Backend Server ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Maintenance mode — when true the backend returns 503 for all /api/* calls
MAINTENANCE_MODE=false

# ── Database (SQL Server) ──────────────────────────────────────────────
DB_HOST=your-db-host.database.windows.net
DB_PORT=1433
DB_NAME=RetailOps
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# ── Amazon Creators API (LiveSync) ─────────────────────────────────────
LIVE_SYNC_CLIENT_ID=your_client_id
LIVE_SYNC_CLIENT_SECRET=your_client_secret
LIVE_SYNC_PARTNER_TAG=your_partner_tag
LIVE_SYNC_MARKETPLACE=www.amazon.in
LIVE_SYNC_ENABLED=true
LIVE_SYNC_SCHEDULE_TIME=06:00

# Secondary credential (required for Live Data Inspector v2)
CREATORS_API_CLIENT_ID_2=your_secondary_client_id
CREATORS_API_CLIENT_SECRET_2=your_secondary_client_secret

# Live Data Inspector — rate limiting & queueing (v2)
LIVE_DATA_V1_ENABLED=false
LIVE_SYNC_RATE_LIMIT_RPS=1
LIVE_SYNC_RATE_LIMIT_BURST=3
LIVE_SYNC_BATCH_SIZE=10
LIVE_SYNC_BATCH_DELAY_MS=1200
LIVE_SYNC_MAX_CONCURRENT_JOBS=2
LIVE_SYNC_MAX_FETCH_ASINS=100
LIVE_SYNC_MAX_UPLOAD_ASINS=50000

# Live Data Inspector v2 — AI-assisted LQS (NVIDIA NIM)
# Requires NVIDIA_NIM_API_KEY to be set. Text + vision AI replaces the
# URL-keyword heuristics for title/bullets/image scoring and falls back to
# the rule-based analyzers whenever AI fails.
LIVE_SYNC_AI_ENABLED=true
# Skip AI analysis when a request/job has more than this many ASINs
LIVE_SYNC_AI_MAX_ASINS=20
# Max concurrent AI analyses across all requests (each runs 1 text + 1 vision call)
# LIVE_SYNC_AI_CONCURRENCY=2
# Per-call timeouts (ms)
# LIVE_SYNC_AI_TIMEOUT_MS=25000
# LIVE_SYNC_AI_VISION_TIMEOUT_MS=40000

# ── Email (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developer@brandcentral.in
SMTP_PASSWORD=your_app_password
SMTP_FROM="Brand Central <developer@brandcentral.in>"

# ── Application URLs ───────────────────────────────────────────────────
FRONTEND_URL=https://data.brandcentral.in
DASHBOARD_URL=https://data.brandcentral.in
APP_URL=https://data.brandcentral.in

# ── Automation ──────────────────────────────────────────────────────────
AUTOMATION_ENABLED=true
AUTOMATION_SCHEDULE_TIME=02:00
AUTOMATION_AMAZON_ENABLED=true
AUTOMATION_AJIO_ENABLED=false

# ── Security ────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# ── Cometchat (Optional) ───────────────────────────────────────────────
# REACT_APP_COMETCHAT_APP_ID=
# REACT_APP_COMETCHAT_AUTH_KEY=

# ── Vercel (Optional) ──────────────────────────────────────────────────
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
