# Copy to .env (optional — script works with no .env at all)
# All settings below can also be passed as CLI flags (see --help in amazon-scraper.js).

# false = visible browser window. When true (default) keeps a real Chromium
# running without any window being shown.
SCRAPER_HEADLESS=true

# Strongly recommended for any real scraping volume. A residential or
# mobile IP (BrightData, Oxylabs, Zyte, etc.) dramatically lowers the chance
# of CAPTCHA. Format: http://user:pass@host:port
# PROXY_URL=

# Per-ASIN retry attempts on network noise (default 3). CAPTCHA failures are
# never retried — they fail fast instead of hammering a block.
SCRAPER_MAX_RETRIES=3

# Timeouts (ms)
SCRAPER_REQUEST_TIMEOUT=30000
SCRAPER_NAVIGATION_TIMEOUT=45000

# Default pause between ASINs (ms). Amazon throttles aggressively — with a
# normal home IP keep this >= 3000-4000. Overridable at runtime with --delay.
SCRAPER_DELAY_MS=2500