flowchart TB
    A([Start: scheduled or manual OOS monitoring])

    subgraph P1["PHASE 1: COLLECT AND VALIDATE DATA"]
      B["RetailOps: identify assigned sellers, active ASINs and marketplace channels"]
      C["RetailOps: retrieve latest availability snapshot and unavailable ASINs"]
      D["RetailOps: retrieve seller-wide ASIN GMS for the chosen comparison period"]
      E["Employee: upload BrandCentral inventory report and applicable Vendor Central inventory report"]
      F{"File coverage, seller mapping, required fields and freshness valid?"}
      G["Request corrected or missing reports; flag data not verified"]
      H["Match records by seller + marketplace + ASIN/SKU; retain separate channel quantities"]
      I["Candidate union: RetailOps unavailable OR BrandCentral zero stock OR Vendor Central zero stock"]
    end

    subgraph P2["PHASE 2: RECONCILE AVAILABILITY"]
      J{"Any affected candidates?"}
      K["No exceptions: capture clean monitoring result"]
      L{"Fresh BrandCentral or Vendor Central report has zero stock?"}
      M["CONFIRMED CHANNEL OOS: identify affected channel and retain source evidence"]
      N{"Both applicable reports show positive stock AND RetailOps says unavailable?"}
      O["RESYNC CANDIDATE: inventory-positive / RetailOps-unavailable mismatch"]
      P["UNVERIFIED / CONFLICT: missing, stale or divergent evidence; request manual check"]
      Q{"Authorized marketplace resync available?"}
      R["Queue one controlled resync; log request ID and time; wait for fresh result"]
      S{"Fresh post-sync RetailOps status is available?"}
      T["RESOLVED MISMATCH: preserve before/after audit; omit from active OOS list"]
      U["OPEN DISCREPANCY: resync unavailable, failed or status unchanged"]
    end

    subgraph P3["PHASE 3: PRIORITIZE AND EXPORT"]
      V["Aggregate OPEN OOS and OPEN discrepancy cases; deduplicate per seller + channel + ASIN"]
      W{"Complete and fresh seller-wide GMS data?"}
      X["Calculate Pareto: sort ALL active ASINs by GMS; mark the ASINs contributing the first approximately 80% of seller GMS"]
      Y["Set GMS priority = unverified; send for manual prioritization (never silently low priority)"]
      Z["Produce Excel resolution workbook: Active OOS, Discrepancies, Resync Resolved, Summary + Evidence"]
    end

    subgraph P4["PHASE 4: RESOLUTION AND GOVERNANCE"]
      AA["Employee validates affected ASINs; assigns owners and seller communication actions"]
      AB["Obtain seller replenishment ETA; record communication and follow-up status"]
      AC["Periodic verified stock refresh and controlled follow-up"]
      AD{"Stock restored for affected channel with fresh evidence?"}
      AE["Close linked inventory incident with restoration evidence"]
      AF["Keep incident OPEN; follow up or escalate by approved policy"]
      AG["Submit today's monitoring report and outstanding-incident handover"]
      AH["Independent reviewer checks coverage, evidence, exceptions and export"]
      AI([Daily monitoring task approved and closed; open incidents remain tracked])
    end

    A --> B --> C --> D --> E --> F
    F -- No --> G --> E
    F -- Yes --> H --> I --> J
    J -- No --> K --> AG
    J -- Yes --> L
    L -- Yes --> M --> V
    L -- No --> N
    N -- Yes --> O --> Q
    N -- No --> P --> V
    Q -- Yes --> R --> S
    Q -- No --> U --> V
    S -- Yes --> T --> Z
    S -- No --> U
    U --> V
    V --> W
    W -- Yes --> X --> Z
    W -- No --> Y --> Z
    Z --> AA --> AB --> AC --> AD
    AD -- Yes --> AE
    AD -- No --> AF --> AC
    Z --> AG --> AH --> AI

    classDef manual fill:#FFF3DE,stroke:#D99529,color:#4F3610,stroke-width:1.4px
    classDef automatic fill:#EAF3FD,stroke:#2A74BA,color:#173C65,stroke-width:1.3px
    classDef check fill:#F2EBFF,stroke:#7655B0,color:#3B275C,stroke-width:1.4px
    classDef incident fill:#FDEBEC,stroke:#C65660,color:#652B31,stroke-width:1.4px
    classDef success fill:#E5F7EF,stroke:#329572,color:#125A43,stroke-width:1.4px
    class E,G,P,AA,AB,AH,Y manual
    class B,C,D,H,I,O,R,V,X,Z,AC,AG automatic
    class F,J,L,N,Q,S,W,AD check
    class M,U,AF incident
    class K,T,AE,AI success
