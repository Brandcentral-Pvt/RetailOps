{
  "$schema": "https://design-tokens.org/automation-rules-index.json",
  "name": "retailops.automation-rules.index",
  "version": "1.0.0",
  "description": "Design tokens consumed by the Automation Rules index page. Every value here is resolved from src/styles/tokens.css and is used by src/styles/rulesets.css. No token on this page is defined locally in the stylesheet.",
  "sourceOfTruth": "src/styles/tokens.css",
  "consumers": [
    "src/styles/rulesets.css",
    "src/pages/RuleSetsPage.jsx"
  ],
  "conventions": {
    "naming": "Semantic token names only (--bc-surface-card, not --bc-white). Raw palette values are never referenced directly by this page.",
    "scope": "Token values are declared on :root. The `body.bc-dark` block overrides 15 of them; the remaining tokens currently have no dark equivalent.",
    "unresolvedTokens": "None. A regression test asserts every --bc-* var() in rulesets.css resolves against document root."
  },
  "darkModeStatus": {
    "activated": false,
    "note": "The `body.bc-dark` class is not applied anywhere in the application, so dark mode is dormant. 15 of the 51 tokens below have dark overrides; the 36 without one (all status, space, radius, and primary-100/200/500/700 tokens) would need dark values before dark mode can be switched on."
  },
  "pageLocalTokens": {
    "$comment": "Density-scoped variables declared in rulesets.css. They alias canonical tokens so density changes stay in one place.",
    "scopeSelector": ".rulesets-tablewrap[data-density] / .rulesets-cards[data-density]",
    "tokens": {
      "--rulesets-head-h": {
        "compact": "28px",
        "comfortable": "36px",
        "roomy": "36px"
      },
      "--rulesets-row-h": {
        "compact": "36px",
        "comfortable": "44px",
        "roomy": "52px"
      },
      "--rulesets-cell-pad-x": {
        "compact": "var(--bc-space-3)",
        "comfortable": "var(--bc-space-4)",
        "roomy": "var(--bc-space-4)"
      },
      "--rulesets-cell-pad-y": {
        "compact": "var(--bc-space-1)",
        "comfortable": "var(--bc-space-2)",
        "roomy": "var(--bc-space-3)"
      },
      "--rulesets-gap-sm": {
        "compact": "var(--bc-space-1)",
        "comfortable": "var(--bc-space-2)",
        "roomy": "var(--bc-space-2)"
      },
      "--rulesets-gap-md": {
        "compact": "var(--bc-space-2)",
        "comfortable": "var(--bc-space-3)",
        "roomy": "var(--bc-space-3)"
      }
    }
  },
  "breakpoints": {
    "$comment": "Declared in rulesets.css. Columns are progressively dropped; below 768px the table is replaced by cards.",
    "wide": "1440px",
    "desktop": "1280px",
    "laptop": "1024px",
    "tablet": "768px",
    "mobile": "480px"
  },
  "tokens": {
    "surface": {
      "--bc-surface-card": {
        "value": "#ffffff",
        "dark": "#1e293b"
      },
      "--bc-surface-hover": {
