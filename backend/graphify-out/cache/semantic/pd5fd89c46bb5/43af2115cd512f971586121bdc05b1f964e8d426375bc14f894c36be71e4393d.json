e": "code", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_lqs_ai_analysis", "label": "AI-Assisted Listing Quality Score (LQS)", "file_type": "rationale", "rationale": "LQS is scored by NVIDIA AI against Amazon listing criteria plus a vision check of the main image because rule heuristics alone cannot judge content quality; rules-based scoring is kept as automatic fallback since AI is slower and can fail, and vision/AI steps are skipped for very large uploads.", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_indexeddb_persistence", "label": "IndexedDB Client-Side Persistence (LiveDataInspector DB)", "file_type": "rationale", "rationale": "Fetched result sets and upload jobs are cached durably in IndexedDB (stores: results, jobs, settings) because batches can reach 50k ASINs and users must be able to reload prior results; quota is monitored via navigator.storage.estimate with a warning above 80% of a ~50MB budget.", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_batch_job_polling", "label": "Async Batch Job Progress Polling", "file_type": "rationale", "rationale": "Bulk uploads (max 50,000 ASINs, ~1.1s per batch of 10) cannot complete within a single HTTP request, so the server returns a jobId and the client polls a progress endpoint every 3 seconds, enabling live percent/found/not-found stats, cancellation, and post-completion download.", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_secondary_credential", "label": "Secondary Credential Isolation (dedicated API key)", "file_type": "rationale", "rationale": "The inspector identifies itself with credId 'secondary' (a dedicated Amazon Creators API key) so ad-hoc inspector traffic is isolated from the primary application integration's quota and rate limits.", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_bearer_token_auth", "label": "Bearer Token Auth (localStorage authToken)", "file_type": "rationale", "rationale": "Every API request attaches a Bearer token read from localStorage['authToken'], keeping authentication uniform across manual fetch, upload, polling, and download calls.", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_metrics", "label": "GET /api/live-data/metrics", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_fetch", "label": "POST /api/live-data/v2/fetch", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_upload", "label": "POST /api/live-data/v2/upload", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_progress", "label": "GET /api/live-data/v2/progress/:jobId", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_cancel", "label": "POST /api/live-data/v2/cancel/:jobId", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_download", "label": "GET /api/live-data/v2/download/:jobId", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "retail_ops_backend_public_live_data_inspector_v2_endpoint_live_data_v2_results", "label": "GET /api/live-data/v2/results/:jobId", "file_type": "concept", "source_file": "public/live-data-inspector-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "retail_ops_backend_public_live_data_inspector_v2_app", "target": "retail_ops_backend_public_live_data_inspector_v2_init", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/live-data-inspector-v2.html", "source_location": null, "weight": 1.0}, {"source": "retail_ops_backend_public_live_data_inspector_v2_init", "target": "retail_ops_backend_public_live_data_inspector_v2_rendermetrics", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/live-data-inspector-v2.html", "source_location": null, "weight": 1.0}, {"source": "retail_ops_backend_public_live_data_inspector_v2_init", "target": "retail_ops_backend_public_live_da