# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001

# SQL Server (primary database)
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=retailops
DB_PORT=1433
DB_POOL_MAX=50
DB_POOL_MIN=5
# Encrypt connection (true/false). If your SQL Server uses a self-signed
# certificate, set DB_ENCRYPT=true and DB_TRUST_SERVER_CERT=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# JWT Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Market Sync
MARKET_SYNC_USERNAME=
MARKET_SYNC_PASSWORD=
MARKET_SYNC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────────
# Amazon Creators API queue (BullMQ) — CURRENTLY DISABLED
# The BullMQ-based queued client (services/creatorsApiQueueService.js) is not
# started in server.js right now. Re-enable only when a Redis >= 5.0.0 is
# available (BullMQ rejects older Redis, e.g. the local v3.0.504 build).
# Until then, live-data calls use the in-process token-bucket rate limiter
# in controllers/pems/liveDataController.js.
# ──────────────────────────────────────────────────────────────────────────
# CREATORS_API_QUEUE_PREFIX=retailops:bullmq
# CREATORS_API_QUEUE_NAME=creators-api-calls
# CREATORS_API_RATE_LIMIT_MAX=1
# CREATORS_API_RATE_LIMIT_DURATION_MS=1000
# CREATORS_API_CACHE_TTL=300
# CREATORS_API_JOB_TIMEOUT_MS=120000
# CREATORS_API_TIMEOUT_MS=30000
# CREATORS_API_TOKEN_TIMEOUT_MS=10000
# Optional secondary credential set for rotation (extra throughput)
# CREATORS_API_CLIENT_ID_2=
# CREATORS_API_CLIENT_SECRET_2=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Services (optional)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
NIM_API_KEY=

# Octoparse (optional)
OCTOPARSE_API_KEY=
