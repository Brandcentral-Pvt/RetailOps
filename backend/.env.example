# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001

# SQL Server (primary database)
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=retailops
DB_PORT=1433
DB_POOL_MAX=50
DB_POOL_MIN=5
# Encrypt connection (true/false). If your SQL Server uses a self-signed
# certificate, set DB_ENCRYPT=true and DB_TRUST_SERVER_CERT=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# JWT Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Market Sync
MARKET_SYNC_USERNAME=
MARKET_SYNC_PASSWORD=
MARKET_SYNC_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Services (optional)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
NIM_API_KEY=

# Octoparse (optional)
OCTOPARSE_API_KEY=

# Dynamic concurrency & circuit breaker settings
SCRAPER_MAX_CONSECUTIVE_FAILURES=5      # Reduce concurrency after this many failures
SCRAPER_MAX_ASIN_FAILURES=5              # Skip ASIN after this many failures
SCRAPER_ASIN_FAILURE_TIMEOUT=300         # ms before resetting circuit (5 min)
SCRAPER_BASE_CONCURRENT_PAGES=10         # Base concurrency (before adaptation)
# Adaptive concurrency bounds
SCRAPER_MIN_CONCURRENT_PAGES=1           # Hard floor for adaptive concurrency
SCRAPER_MAX_CONCURRENT_PAGES=20          # Hard ceiling for adaptive concurrency

# Improved retry backoff settings
SCRAPER_BACKOFF_BASE=2000                # Base backoff in ms (2s)
SCRAPER_BACKOFF_MAX=60000                # Max backoff in ms (60s)
SCRAPER_BACKOFF_JITTER=0.25              # Jitter % (±25% of base delay)

# PEMS Tasks Phase 1 developer checks (enable only on a migrated test database)
# Both default to false. Strict mode requires activity-linked PemsEvidence
# and completed mandatory activity/phase/brand states before task submission.
PEMS_STRICT_ACTIVITY_GATES=false
# Pin the published task view JSON and copied SOP in the same instance-creation transaction.
# Requires migrations 033 and 034. Historical tasks without pins remain on the legacy view.
PEMS_PIN_VIEW_SNAPSHOTS=false
 
# PEMS Phase 2.2: typed step output storage and conditional-free V2 execution.
# Default off. Requires migrations 033, 034 and 042, plus BOTH Phase 1 flags
# above set to true on an isolated development database. Conditional branches
# remain preview-only until Phase 2.3.
PEMS_V2_EXECUTION_ENABLED=false
