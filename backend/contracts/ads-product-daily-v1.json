  "metricContract": {
    "totalSales": "metrics.total_sales; reconcile with metrics.ordered_revenue when both present. Never derive from ad plus organic.",
    "totalOrders": "metrics.total_orders; reconcile with metrics.ordered_orders. Never derive from ad plus organic.",
    "totalUnits": "metrics.total_units; reconcile with metrics.units_ordered.",
    "acos": "sum(spend)/sum(ad sales)*100 if denominator positive and required coverage exists",
    "tacos": "sum(spend)/sum(explicit total sales)*100 if denominator positive and required coverage exists",
    "roas": "sum(ad sales)/sum(spend)",
    "ctr": "sum(clicks)/sum(impressions)*100",
    "cvr": "sum(conversions)/sum(clicks)*100; matches supplied source; order rate separately named",
    "cpc": "sum(spend)/sum(clicks)",
    "aov": "sum(ad sales)/sum(conversions); matches supplied source; order-based AOV separately named",
    "cpo": "sum(spend)/sum(ad orders)",
    "adSalesShare": "sum(ad sales)/sum(explicit total sales)*100; may exceed 100",
    "coverage": "Track populated versus missing values per metric, seller, period and row family. Missing denominator or unknown aggregate is null, not zero. Partial coverage is explicitly labelled; ratio numerator and denominator population must be documented and comparable.",
    "monthly": "Calendar-month rollup of validated daily facts; legacy monthly records isolated until a separate source contract and reconciliation are approved."
  },
  "storage": {
    "table": "dbo.AdsProductDailyFacts",
    "decimalType": "decimal(28,10)",
    "integerType": "bigint",
    "state": "canonical schema; ingestion activation pending"
  }
}
